{
  "expo": {
    "name": "Project Torch",
    "slug": "project-torch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Access to flash is required to illuminate the torch."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a1120",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.FLASHLIGHT",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.sumraaa.projecttorch"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Access to flash is required to illuminate the torch."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "de2bfa2e-9a70-4513-a86e-d5a081b13cf3"
      }
    }
  }
}
