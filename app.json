{
  "expo": {
    "name": "Project Torch",
    "slug": "project-torch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Access to flash is required to illuminate the torch."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a1120",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.FLASHLIGHT"]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Access to flash is required to illuminate the torch."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
